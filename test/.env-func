PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=mcm
DATABASE_PASSWORD=mcm
DATABASE_SCHEMA=mcm

VAULT_ENDPOINT=http://localhost:8233
VAULT_AUTH_METHOD=APP_ROLE
VAULT_ROLE_ID_FILE=./docker/vault/tmp/role-id
VAULT_ROLE_SECRET_ID_FILE=./docker/vault/tmp/secret-id
VAULT_PKI_CLIENT_ROLE=example.com
VAULT_PKI_SERVER_ROLE=example.com
SWITCH_ID=switch_id_1

# Ory IAM integration settings
IAM_ENABLED=false
IAM_AUTO_CREATE_ACCOUNTS=false

HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_AUDIENCE=connection-manager-api

KRATOS_ADMIN_URL=http://localhost:4434
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_IDENTITY_SCHEMA_ID=default

KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467

CA_CSR_PARAMETERS=docker/pki/ca-csr.json
CLIENT_CSR_PARAMETERS=docker/pki/client-csr.json
SERVER_CSR_PARAMETERS=docker/pki/server-csr.json

DFSP_SEED=dfsp_1:XXX
LOG_LEVEL=verbose
