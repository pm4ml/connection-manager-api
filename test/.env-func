PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=mcm
DATABASE_PASSWORD=mcm
DATABASE_SCHEMA=mcm

VAULT_ENDPOINT=http://vault.mcm.localhost
VAULT_AUTH_METHOD=APP_ROLE
VAULT_ROLE_ID_FILE=./docker/vault/tmp/role-id
VAULT_ROLE_SECRET_ID_FILE=./docker/vault/tmp/secret-id
VAULT_PKI_CLIENT_ROLE=example.com
VAULT_PKI_SERVER_ROLE=example.com
SWITCH_ID=switch_id_1

IAM_ENABLED=true
IAM_AUTO_CREATE_ACCOUNTS=true
HYDRA_PUBLIC_URL=http://hydra.mcm.localhost
HYDRA_ADMIN_URL=http://hydra-admin.mcm.localhost
HYDRA_AUDIENCE=connection-manager-api
KRATOS_PUBLIC_URL=http://kratos.mcm.localhost
KRATOS_ADMIN_URL=http://kratos-admin.mcm.localhost
KRATOS_IDENTITY_SCHEMA_ID=default
KETO_READ_URL=http://keto-read.mcm.localhost
KETO_WRITE_URL=http://keto-write.mcm.localhost

APP_ENDPOINT=http://mcm.localhost/api

DFSP_SEED=dfsp_1:XXX
LOG_LEVEL=verbose
